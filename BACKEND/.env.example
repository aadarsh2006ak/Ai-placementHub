# Server Environment Configuration
PORT=3000
NODE_ENV=development

# MongoDB Database Connection
MONGO_URI=your_mongodb_uri_here

# JWT Authentication Secret (32+ chars recommended)
JWT_SECRET=your_jwt_super_secret_signing_key_here

# Google Gemini AI API Key (for ATS, Skill Gap & Interview Simulator)
GEMINI_API_KEY=your_gemini_api_key_here

# Client URL (Allowed CORS Origins, comma-separated if multiple)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Placement Hub" <no-reply@placementhub.com>

# Cloudinary Storage Configuration (PDF CVs, logos, media)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
